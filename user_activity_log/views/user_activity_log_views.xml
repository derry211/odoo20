<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_user_activity_log_list" model="ir.ui.view">
        <field name="name">user.activity.log.list</field>
        <field name="model">user.activity.log</field>
        <field name="arch" type="xml">
            <list string="User Activity Log" create="false" edit="false" delete="false">
                <field name="create_date" string="Time (UTC)"/>
                <field name="local_time"/>
                <field name="user_id"/>
                <field name="login" optional="hide"/>
                <field name="action"/>
                <field name="model_name" optional="show"/>
                <field name="record_name" optional="show"/>
                <field name="description"/>
                <field name="http_path" optional="hide"/>
                <field name="ip_address" optional="hide"/>
                <field name="user_tz" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_user_activity_log_form" model="ir.ui.view">
        <field name="name">user.activity.log.form</field>
        <field name="model">user.activity.log</field>
        <field name="arch" type="xml">
            <form string="User Activity Log" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group string="User">
                            <field name="user_id"/>
                            <field name="login"/>
                            <field name="action"/>
                            <field name="ip_address"/>
                            <field name="user_tz"/>
                        </group>
                        <group string="Target">
                            <field name="model_name"/>
                            <field name="res_id"/>
                            <field name="record_name"/>
                            <field name="http_path"/>
                        </group>
                    </group>
                    <group string="Time">
                        <group>
                            <field name="create_date" string="Time (UTC)"/>
                        </group>
                        <group>
                            <field name="local_time"/>
                        </group>
                    </group>
                    <group string="Activity">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_user_activity_log_search" model="ir.ui.view">
        <field name="name">user.activity.log.search</field>
        <field name="model">user.activity.log</field>
        <field name="arch" type="xml">
            <search string="User Activity Log">
                <field name="user_id"/>
                <field name="model_name"/>
                <field name="record_name"/>
                <field name="http_path"/>
                <filter name="filter_today" string="Today" date="create_date"/>
                <separator/>
                <filter name="filter_login" string="Login" domain="[('action','=','login')]"/>
                <filter name="filter_logout" string="Logout" domain="[('action','=','logout')]"/>
                <filter name="filter_access" string="Page Access" domain="[('action','=','access')]"/>
                <filter name="filter_create" string="Create" domain="[('action','=','create')]"/>
                <filter name="filter_write" string="Update" domain="[('action','=','write')]"/>
                <filter name="filter_unlink" string="Delete" domain="[('action','=','unlink')]"/>
                <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                <filter name="group_action" string="Action" context="{'group_by': 'action'}"/>
                <filter name="group_model" string="Model" context="{'group_by': 'model_name'}"/>
                <filter name="group_date" string="Date" context="{'group_by': 'create_date:day'}"/>
            </search>
        </field>
    </record>

    <record id="action_user_activity_log" model="ir.actions.act_window">
        <field name="name">User Activity Log</field>
        <field name="res_model">user.activity.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_user_activity_log_search"/>
    </record>

    <menuitem id="menu_user_activity_log"
              name="User Activity Log"
              parent="base.menu_custom"
              action="action_user_activity_log"
              sequence="95"
              groups="base.group_system"/>

</odoo>
